<?xml version="1.0" encoding="utf-8"?>
<!-- MX Player 2.12.4 decoded styles for OFFLINE surfaces, framework-only adaptation.
     Item VALUES are verbatim from RESOURCE-TRUTH.md S5 / decoded styles.xml.
     MX parents are AppCompat styles, which this framework-only app does not ship,
     so parents are the closest framework TextAppearance/Theme and AppCompat-only
     attributes are dropped (recorded per style). MX fontFamily items reference
     @font/font_muli* (Mulish) — omitted because no legitimately usable Mulish
     exists on this VM (see V4-WORKLOG Foundation notes); default font stands. -->
<resources>

    <!-- MX `ToolbarTitleText` (no parent): textSize 14sp, fontFamily
         @font/font_muli_semibold (omitted, font PARTIAL). -->
    <style name="ToolbarTitleText">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- MX `MXThemeToolbarTitleBase`: textSize @dimen/sp18, fontFamily semibold (omitted). -->
    <style name="MXThemeToolbarTitleBase">
        <item name="android:textSize">@dimen/sp18</item>
    </style>

    <!-- MX `MXToolbarTitleDefault`: parent MXToolbarTitleBase, textColor white. -->
    <style name="MXToolbarTitleDefault" parent="@style/MXThemeToolbarTitleBase">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- MX `MXToolbarTitleDark`: parent MXToolbarTitleBase, textColor @color/mx_text_color_primary. -->
    <style name="MXToolbarTitleDark" parent="@style/MXThemeToolbarTitleBase">
        <item name="android:textColor">@color/mx_text_color_primary</item>
    </style>

    <!-- MX `MXToolbarTitleAurora`: parent MXToolbarTitleBase, textColor @color/mxskin__grid_primary_text__light. -->
    <style name="MXToolbarTitleAurora" parent="@style/MXThemeToolbarTitleBase">
        <item name="android:textColor">@color/mxskin__grid_primary_text__light</item>
    </style>

    <!-- MX `ToolbarTitleStyle` (parent AppCompat Toolbar Title): 18sp, bold, white, center. -->
    <style name="ToolbarTitleStyle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- MX `PlayerToolbarTitle` (parent AppCompat Toolbar Title): textSize 20sp. -->
    <style name="PlayerToolbarTitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- MX `MxText` base (no items) and its decoded size/color variants.
         MxText.Medium / *.font_muli* differ only by fontFamily — omitted (font PARTIAL). -->
    <style name="MxText" />
    <style name="MxText.14sp" parent="@style/MxText">
        <item name="android:textSize">@dimen/sp14_un_sw</item>
    </style>
    <style name="MxText.14sp.white" parent="@style/MxText.14sp">
        <item name="android:textColor">@android:color/white</item>
    </style>
    <style name="MxText.14sp.blue" parent="@style/MxText.14sp">
        <item name="android:textColor">@color/common_offline_btn_text_color</item>
    </style>
    <style name="MxText.Medium.12sp" parent="@style/MxText">
        <item name="android:textSize">@dimen/sp12_un_sw</item>
    </style>
    <style name="MxText.Medium.12sp.white" parent="@style/MxText.Medium.12sp">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- MX dialog text appearances (`MxOne*`): values verbatim, fontFamily omitted. -->
    <style name="MxOneAlertDialogTitleTextAppearance" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ff35344c</item>
    </style>
    <style name="MxOneAlertDialogTitleTextAppearanceDark" parent="@style/MxOneAlertDialogTitleTextAppearance">
        <item name="android:textColor">#ffdadde4</item>
    </style>
    <style name="MxOneMessageTextAppearance" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#ff505a78</item>
    </style>
    <style name="MxOneMessageTextAppearanceDark" parent="@style/MxOneMessageTextAppearance">
        <item name="android:textColor">#ffdadde4</item>
    </style>
    <style name="MxOnePositiveButtonTextAppearance" parent="@android:style/TextAppearance.Material.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#ff3c8cf0</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="MxOneNegativeButtonTextAppearance" parent="@android:style/TextAppearance.Material.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#ff96a2ba</item>
    </style>
    <style name="MxOneNegativeButtonTextAppearanceDark" parent="@style/MxOneNegativeButtonTextAppearance">
        <item name="android:textColor">#ffdadde4</item>
    </style>

    <!-- MX `Base.Playback.Dark` framework items only: black background/window,
         no frame, no content overlay, no window animation. AppCompat/custom
         attrs (actionBarStyle, equalizer*, mxPlayerDialog*, …) dropped. -->
    <style name="MxPlaybackTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- MX `MxChannelModalStyle` / `MxOneBottomSheetStyle*` panel geometry:
         the decoded modal styles set only android:background; the channel
         modal's is @android:color/transparent, kept verbatim here. -->
    <style name="MxBottomSheetModal" parent="@android:style/Theme.Material.Dialog">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>
