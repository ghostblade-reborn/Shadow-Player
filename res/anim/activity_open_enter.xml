<?xml version="1.0" encoding="utf-8"?>
<!-- v0.5.7 whole-UI motion: incoming activity fades in while
     settling from a small right offset. Alpha + translation only,
     decelerate — hardware-accelerated, no scale/bounce. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0"
        android:duration="260" />
    <translate android:fromXDelta="6%" android:toXDelta="0"
        android:fromYDelta="0" android:toYDelta="0"
        android:duration="260" />
</set>
